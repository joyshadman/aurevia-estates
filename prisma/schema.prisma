// Prisma owns every table, including Better Auth's (spec 0008), in `public`.
// Older migrations enable row level security behind a guarded block that does
// nothing on Neon; tables added since spec 0008 don't.
//
// Spec 0002 (data model). Several rules live only in the migration SQL, not here:
// check constraints (`*_ck`), `listing_ref_seq`, the `chat_messages.seq` identity,
// and the RLS lines. Read `prisma/migrations/*/migration.sql` before editing.

generator client {
  provider        = "prisma-client"
  output          = "../lib/generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  VISITOR
  AGENT
  SELLER

  @@map("user_role")
}

enum DealType {
  SALE

  @@map("deal_type")
}

enum PropertyType {
  APARTMENT
  DUPLEX
  VILLA
  HOUSE
  PLOT
  COMMERCIAL

  @@map("property_type")
}

enum ListingStatus {
  DRAFT
  PENDING_REVIEW
  CHANGES_REQUESTED
  REJECTED
  PUBLISHED
  UNPUBLISHED
  SOLD

  @@map("listing_status")
}

enum CompletionStatus {
  READY
  UNDER_CONSTRUCTION

  @@map("completion_status")
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM

  @@map("message_role")
}

enum LeadSource {
  CHAT_BOOKING
  CONTACT_FORM
  LISTING_INQUIRY

  @@map("lead_source")
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  WON
  LOST

  @@map("lead_status")
}

enum ViewingStatus {
  REQUESTED
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW

  @@map("viewing_status")
}

// Spec 0019: an outbox row's delivery state.
enum OutboxStatus {
  PENDING
  SENT
  FAILED

  @@map("outbox_status")
}

enum LeadActivityType {
  NOTE
  STATUS_CHANGE
  VIEWING_CHANGE
  SYSTEM

  @@map("lead_activity_type")
}

// Better Auth's user table (spec 0008, *Data model*): Better Auth creates the
// row at first sign in. The row stays as a tombstone after account deletion
// (spec 0002, AC-10). `full_name` is '' when not set; read it through
// `displayName()`.
model Profile {
  id               String    @id @default(uuid(7)) @db.Uuid
  role             UserRole  @default(VISITOR)
  email            String    @unique
  emailVerified    Boolean   @default(false) @map("email_verified")
  twoFactorEnabled Boolean   @default(false) @map("two_factor_enabled")
  fullName         String    @default("") @map("full_name")
  phone            String?
  // Spec 0007: the visitor says whether `phone` is on WhatsApp.
  phoneIsWhatsapp  Boolean   @default(true) @map("phone_is_whatsapp")
  avatarUrl        String?   @map("avatar_url")
  agentTitle       String?   @map("agent_title")
  agentWhatsapp    String?   @map("agent_whatsapp")
  agentBio         String?   @map("agent_bio")
  agentPhotoUrl    String?   @map("agent_photo_url")
  agentIsPublic    Boolean   @default(false) @map("agent_is_public")
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  createdListings  Listing[]            @relation("ListingCreatedBy")
  assignedListings Listing[]            @relation("ListingAssignedAgent")
  conversations    Conversation[]
  factSheets       AssistantFactSheet[]
  visitorLeads     Lead[]               @relation("LeadVisitor")
  assignedLeads    Lead[]               @relation("LeadAssignedAgent")
  leadActivities   LeadActivity[]
  aiUsage          AiUsageDaily[]
  sessions         Session[]
  accounts         Account[]
  twoFactor        TwoFactor?
  savedHomes       SavedHome[]
  outboxEmails     EmailOutbox[]
  photoFiles       PhotoFile[]

  @@map("profiles")
}

// Better Auth tables (spec 0008, *Data model*). Field names follow Better Auth
// 1.7; ids come from Prisma's `uuid(7)` default (`generateId: "uuid"`).

model Session {
  id                  String    @id @default(uuid(7)) @db.Uuid
  userId              String    @map("user_id") @db.Uuid
  token               String    @unique
  expiresAt           DateTime  @map("expires_at") @db.Timestamptz(3)
  ipAddress           String?   @map("ip_address")
  userAgent           String?   @map("user_agent")
  // When this session last passed the authenticator step (AC-8).
  twoFactorVerifiedAt DateTime? @map("two_factor_verified_at") @db.Timestamptz(3)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  user Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id @default(uuid(7)) @db.Uuid
  userId                String    @map("user_id") @db.Uuid
  // `credential` or `google`.
  providerId            String    @map("provider_id")
  accountId             String    @map("account_id")
  password              String?
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz(3)
  scope                 String?
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  user Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("accounts")
}

// Email codes, one row per email and purpose; the code is stored hashed (AC-2).
model Verification {
  id         String   @id @default(uuid(7)) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([identifier])
  @@map("verifications")
}

// One authenticator per user; Better Auth encrypts `secret` and `backup_codes`.
model TwoFactor {
  id                      String    @id @default(uuid(7)) @db.Uuid
  userId                  String    @unique @map("user_id") @db.Uuid
  secret                  String
  backupCodes             String    @map("backup_codes")
  verified                Boolean   @default(true)
  failedVerificationCount Int       @default(0) @map("failed_verification_count")
  lockedUntil             DateTime? @map("locked_until") @db.Timestamptz(3)

  user Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([secret])
  @@map("two_factors")
}

// Our own auth rate limiter and code cooldowns (`lib/server/auth-limits.ts`).
// `last_request` is epoch milliseconds.
model RateLimit {
  id          String @id @default(uuid(7)) @db.Uuid
  key         String @unique
  count       Int
  lastRequest BigInt @map("last_request")

  @@map("rate_limits")
}

model Area {
  id        String  @id @default(uuid(7)) @db.Uuid
  slug      String  @unique
  nameEn    String  @map("name_en")
  nameBn    String  @map("name_bn")
  centerLat Float   @map("center_lat")
  centerLng Float   @map("center_lng")
  isActive  Boolean @default(true) @map("is_active")
  sortOrder Int     @map("sort_order")

  listings Listing[]

  @@map("areas")
}

model Amenity {
  id        String  @id @default(uuid(7)) @db.Uuid
  slug      String  @unique
  label     String
  labelBn   String? @map("label_bn")
  icon      String?
  sortOrder Int     @map("sort_order")
  isActive  Boolean @default(true) @map("is_active")

  listings ListingAmenity[]

  @@map("amenities")
}

model Listing {
  id               String            @id @default(uuid(7)) @db.Uuid
  slug             String            @unique
  refCode          String            @unique @map("ref_code")
  dealType         DealType          @default(SALE) @map("deal_type")
  propertyType     PropertyType      @map("property_type")
  status           ListingStatus     @default(DRAFT)
  title            String
  description      String?
  priceBdt         BigInt?           @map("price_bdt")
  priceNegotiable  Boolean           @default(false) @map("price_negotiable")
  areaId           String            @map("area_id") @db.Uuid
  addressLine      String?           @map("address_line")
  latitude         Float?
  longitude        Float?
  bedrooms         Int?
  bathrooms        Int?
  builtUpSqft      Int?              @map("built_up_sqft")
  landKatha        Decimal?          @map("land_katha") @db.Decimal(7, 2)
  floorNumber      Int?              @map("floor_number")
  totalFloors      Int?              @map("total_floors")
  parkingSpaces    Int?              @map("parking_spaces")
  completionStatus CompletionStatus? @map("completion_status")
  handoverDate     DateTime?         @map("handover_date") @db.Date
  createdById      String            @map("created_by_id") @db.Uuid
  assignedAgentId  String?           @map("assigned_agent_id") @db.Uuid
  publishedAt      DateTime?         @map("published_at") @db.Timestamptz(3)
  soldAt           DateTime?         @map("sold_at") @db.Timestamptz(3)
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime          @default(dbgenerated("date_trunc('milliseconds'::text, now())")) @updatedAt @map("updated_at") @db.Timestamptz(3)

  area            Area                    @relation(fields: [areaId], references: [id], onDelete: Restrict)
  createdBy       Profile                 @relation("ListingCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  assignedAgent   Profile?                @relation("ListingAssignedAgent", fields: [assignedAgentId], references: [id], onDelete: Restrict)
  amenities       ListingAmenity[]
  photos          ListingPhoto[]
  conversations   Conversation[]
  recommendations ListingRecommendation[]
  leads           Lead[]
  savedBy         SavedHome[]

  @@index([status, publishedAt(sort: Desc), id(sort: Desc)])
  @@index([status, areaId, priceBdt])
  @@index([status, propertyType, bedrooms])
  @@index([assignedAgentId, status])
  @@index([createdById])
  @@index([areaId])
  @@map("listings")
}

model ListingAmenity {
  listingId String @map("listing_id") @db.Uuid
  amenityId String @map("amenity_id") @db.Uuid

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  amenity Amenity @relation(fields: [amenityId], references: [id], onDelete: Restrict)

  @@id([listingId, amenityId])
  @@index([amenityId])
  @@map("listing_amenities")
}

model ListingPhoto {
  id          String   @id @default(uuid(7)) @db.Uuid
  listingId   String   @map("listing_id") @db.Uuid
  url         String?
  storagePath String?  @map("storage_path")
  sortOrder   Int      @map("sort_order")
  isCover     Boolean  @default(false) @map("is_cover")
  alt         String
  width       Int?
  height      Int?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([listingId], map: "listing_photos_one_cover_uq", where: raw("is_cover"))
  @@index([listingId, sortOrder])
  @@map("listing_photos")
}

model Conversation {
  id              String    @id @default(uuid(7)) @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  title           String?
  startListingId  String?   @map("start_listing_id") @db.Uuid
  lastMessageAt   DateTime  @default(now()) @map("last_message_at") @db.Timestamptz(3)
  // Spec 0006: a reply is running while this is set and under 90 seconds old.
  turnStartedAt   DateTime? @map("turn_started_at") @db.Timestamptz(3)
  // Spec 0006: honored only when later than `turnStartedAt`.
  stopRequestedAt DateTime? @map("stop_requested_at") @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  user            Profile                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  startListing    Listing?                @relation(fields: [startListingId], references: [id], onDelete: SetNull)
  messages        ChatMessage[]
  brief           SearchBrief?
  recommendations ListingRecommendation[]
  leads           Lead[]
  viewings        Viewing[]

  @@index([userId, lastMessageAt(sort: Desc)])
  @@index([startListingId])
  @@map("conversations")
}

// `id` is the AI SDK message id. `seq` is the send order: the migration turns it
// into `generated always as identity`, so never write it.
model ChatMessage {
  id             String      @id
  seq            BigInt      @default(autoincrement())
  conversationId String      @map("conversation_id") @db.Uuid
  role           MessageRole
  parts          Json        @db.JsonB
  textContent    String      @map("text_content")
  metadata       Json?       @db.JsonB
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  conversation    Conversation            @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  recommendations ListingRecommendation[]

  @@index([conversationId, seq])
  @@map("chat_messages")
}

// What the visitor told the assistant, 1:1 with a conversation. The id arrays
// carry no FK; the brief service validates ids on write.
model SearchBrief {
  conversationId String         @id @map("conversation_id") @db.Uuid
  budgetMinBdt   BigInt?        @map("budget_min_bdt")
  budgetMaxBdt   BigInt?        @map("budget_max_bdt")
  propertyTypes  PropertyType[] @default([]) @map("property_types")
  areaIds        String[]       @default([]) @map("area_ids") @db.Uuid
  amenityIds     String[]       @default([]) @map("amenity_ids") @db.Uuid
  minBedrooms    Int?           @map("min_bedrooms")
  minBathrooms   Int?           @map("min_bathrooms")
  familySize     Int?           @map("family_size")
  notes          String?
  updatedAt      DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@map("search_briefs")
}

model ListingRecommendation {
  id             String   @id @default(uuid(7)) @db.Uuid
  conversationId String   @map("conversation_id") @db.Uuid
  messageId      String   @map("message_id")
  listingId      String   @map("listing_id") @db.Uuid
  rank           Int
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  message      ChatMessage  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  listing      Listing      @relation(fields: [listingId], references: [id], onDelete: Restrict)

  @@unique([messageId, listingId])
  @@index([conversationId])
  @@index([listingId])
  @@map("listing_recommendations")
}

model Lead {
  id              String     @id @default(uuid(7)) @db.Uuid
  source          LeadSource
  status          LeadStatus @default(NEW)
  visitorId       String?    @map("visitor_id") @db.Uuid
  listingId       String?    @map("listing_id") @db.Uuid
  conversationId  String?    @map("conversation_id") @db.Uuid
  assignedAgentId String?    @map("assigned_agent_id") @db.Uuid
  contactName     String     @map("contact_name")
  contactPhone    String?    @map("contact_phone")
  contactEmail    String?    @map("contact_email")
  // Spec 0007: null for leads that never asked (contact form, listing inquiry).
  contactWhatsapp Boolean?   @map("contact_whatsapp")
  message         String?
  contactedAt     DateTime?  @map("contacted_at") @db.Timestamptz(3)
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  visitor       Profile?       @relation("LeadVisitor", fields: [visitorId], references: [id], onDelete: SetNull)
  listing       Listing?       @relation(fields: [listingId], references: [id], onDelete: Restrict)
  conversation  Conversation?  @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  assignedAgent Profile?       @relation("LeadAssignedAgent", fields: [assignedAgentId], references: [id], onDelete: SetNull)
  viewings      Viewing[]
  activities    LeadActivity[]

  @@unique([visitorId, listingId], map: "leads_open_per_visitor_listing_uq", where: raw("(status = ANY (ARRAY['NEW'::lead_status, 'CONTACTED'::lead_status, 'QUALIFIED'::lead_status])) AND (visitor_id IS NOT NULL) AND (listing_id IS NOT NULL)"))
  @@index([assignedAgentId, status, createdAt(sort: Desc)])
  @@index([visitorId])
  @@index([listingId])
  @@index([conversationId])
  @@map("leads")
}

// The listing comes from the lead, so the two can never drift. The partial index
// predicates are written in the form Postgres stores them, so the drift check
// (AC-14) compares equal.
model Viewing {
  id             String        @id @default(uuid(7)) @db.Uuid
  leadId         String        @map("lead_id") @db.Uuid
  requestedFor   DateTime      @map("requested_for") @db.Timestamptz(3)
  confirmedFor   DateTime?     @map("confirmed_for") @db.Timestamptz(3)
  status         ViewingStatus @default(REQUESTED)
  cancelReason   String?       @map("cancel_reason")
  // Spec 0007: the chat it was booked from; viewings with one are the ones
  // booked through the assistant (the success metric).
  conversationId String?       @map("conversation_id") @db.Uuid
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  lead         Lead          @relation(fields: [leadId], references: [id], onDelete: Cascade)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  @@unique([leadId], map: "viewings_active_per_lead_uq", where: raw("status = ANY (ARRAY['REQUESTED'::viewing_status, 'CONFIRMED'::viewing_status])"))
  @@index([leadId, requestedFor])
  @@index([conversationId])
  @@map("viewings")
}

model LeadActivity {
  id         String           @id @default(uuid(7)) @db.Uuid
  leadId     String           @map("lead_id") @db.Uuid
  actorId    String?          @map("actor_id") @db.Uuid
  type       LeadActivityType
  body       String?
  fromStatus String?          @map("from_status")
  toStatus   String?          @map("to_status")
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  lead  Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  actor Profile? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([leadId, createdAt])
  @@index([actorId])
  @@map("lead_activities")
}

// `day` is the Asia/Dhaka calendar day, computed in SQL by `recordUsage`.
model AiUsageDaily {
  userId       String   @map("user_id") @db.Uuid
  day          DateTime @db.Date
  messageCount Int      @default(0) @map("message_count")
  inputTokens  Int      @default(0) @map("input_tokens")
  outputTokens Int      @default(0) @map("output_tokens")

  user Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, day])
  @@map("ai_usage_daily")
}

// The agency fact sheet the assistant quotes (spec 0006). One row per saved
// version. The live version is the one no row names as `previous_id`; the unique
// `previous_id` makes two saves from the same version impossible. The body
// length check lives in the migration SQL.
model AssistantFactSheet {
  id             String   @id @default(uuid(7)) @db.Uuid
  body           String
  previousId     String?  @unique @map("previous_id") @db.Uuid
  createdById    String?  @map("created_by_id") @db.Uuid
  restoredFromId String?  @map("restored_from_id") @db.Uuid
  createdAt      DateTime @map("created_at") @db.Timestamptz(3)

  previous     AssistantFactSheet?  @relation("FactSheetPrevious", fields: [previousId], references: [id], onDelete: Restrict)
  next         AssistantFactSheet?  @relation("FactSheetPrevious")
  restoredFrom AssistantFactSheet?  @relation("FactSheetRestoredFrom", fields: [restoredFromId], references: [id], onDelete: SetNull)
  restores     AssistantFactSheet[] @relation("FactSheetRestoredFrom")
  createdBy    Profile?             @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([createdAt(sort: Desc), id(sort: Desc)])
  @@index([createdById])
  @@index([restoredFromId])
  @@map("assistant_fact_sheets")
}

// Spec 0014 (saved homes): a user's hearts. Saving twice is a no op; both
// sides cascade, so deleting a user or a listing removes their rows.
model SavedHome {
  profileId String   @map("profile_id") @db.Uuid
  listingId String   @map("listing_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@id([profileId, listingId])
  @@index([profileId, createdAt(sort: Desc)])
  @@index([listingId])
  @@map("saved_homes")
}

// Spec 0019 (booking and lead notifications): emails queued in the writer's
// transaction, sent after the response, retried by the cron. `payload` holds
// everything the template needs, so a send never re-reads. Sent rows are
// deleted after 30 days; the payload is personal data.
model EmailOutbox {
  id            String       @id @default(uuid(7)) @db.Uuid
  kind          String
  toEmail       String       @map("to_email")
  profileId     String?      @map("profile_id") @db.Uuid
  payload       Json
  status        OutboxStatus @default(PENDING)
  attempts      Int          @default(0)
  nextAttemptAt DateTime     @default(now()) @map("next_attempt_at") @db.Timestamptz(3)
  lastError     String?      @map("last_error")
  sentAt        DateTime?    @map("sent_at") @db.Timestamptz(3)
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  profile Profile? @relation(fields: [profileId], references: [id], onDelete: SetNull)

  @@index([status, nextAttemptAt])
  @@index([profileId])
  @@map("email_outbox")
}

// Spec 0020 (listing photo upload; spec 0001, *File storage*): uploaded photo
// bytes, WebP at most 2000px, keyed by the hash of those bytes. Only the photo
// route reads `bytes`; list queries never select it. `listing_photos.storage_path`
// holds the hash.
model PhotoFile {
  sha256      String   @id
  bytes       Bytes
  width       Int
  height      Int
  byteSize    Int      @map("byte_size")
  createdById String?  @map("created_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  createdBy Profile? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([createdById])
  @@map("photo_files")
}
