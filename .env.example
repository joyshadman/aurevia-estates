# Local secrets. Git ignores this file. Fill in each value, then tell Claude.

# Supabase project (Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Canonical site origin for redirects and email links (spec 0004)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# hCaptcha (spec 0004). These are hCaptcha's test keys; use real ones on staging and production.
NEXT_PUBLIC_HCAPTCHA_SITE_KEY=your_hcaptcha_site_key
HCAPTCHA_SECRET=your_hcaptcha_secret

# Postgres: pooled connection for the app, direct connection for migrations.
# Copy both from the Neon console (Connect). DIRECT_URL is the same host without "-pooler".
DATABASE_URL=postgresql://USER:PASSWORD@HOST.us-east-2.aws.neon.tech/neondb?sslmode=verify-full&channel_binding=require
DIRECT_URL=postgresql://USER:PASSWORD@HOST.us-east-2.aws.neon.tech/neondb?sslmode=verify-full&channel_binding=require

# AI chat (spec 0001, feature 7)
OPENROUTER_API_KEY=your_openrouter_api_key
AI_CHAT_MODEL=openai/gpt-oss-120b

# Auth emails (spec 0004). Fill in to send sign in codes.
SEND_EMAIL_HOOK_SECRET=your_send_email_hook_secret
RESEND_API_KEY=your_resend_api_key
AUTH_EMAIL_FROM="Your App Name <noreply@yourdomain.com>"

# Sentry (optional; reporting is off while empty)
SENTRY_DSN=https://your_sentry_dsn@o000000.ingest.sentry.io/0000000
NEXT_PUBLIC_SENTRY_DSN=https://your_sentry_dsn@o000000.ingest.sentry.io/0000000

# Better Auth (spec 0008), dev only. Set once: rotating it signs everyone out.
BETTER_AUTH_SECRET=your_better_auth_secret

# Google sign in (spec 0008), redirect URI <site>/api/auth/callback/google
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Booking and lead notifications (spec 0019). Falls back to AUTH_EMAIL_FROM.
NOTIFY_EMAIL_FROM=
# Vercel Cron sends `Authorization: Bearer <CRON_SECRET>` to /api/cron/outbox.
CRON_SECRET=your_cron_secret

# Product analytics (spec 0018), loaded only after cookie consent. Empty = off.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Sentry source map upload at build time (spec 0018). Empty = no upload.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=