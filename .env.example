# Copy to .env.local and fill in. Never commit real values.
# Each feature adds its own variables here when it is built (spec 0001).

# Supabase project (Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SERVICE_ROLE_KEY=

# Postgres app database
# Runtime: pooled connection
DATABASE_URL=postgresql://<user>:<password>@<pooled-host>/<db>?sslmode=require
# Migrations: direct (non pooled) connection
DIRECT_URL=postgresql://<user>:<password>@<direct-host>/<db>?sslmode=require
# Optional: shadow database for `prisma migrate dev` and `npm run db:drift` (spec 0002).
# A throwaway local Postgres, e.g. `podman run -d --name aurevia-shadow -e POSTGRES_PASSWORD=shadow -e POSTGRES_DB=shadow -p 54329:5432 postgres:17-alpine`
# SHADOW_DATABASE_URL=postgresql://postgres:shadow@127.0.0.1:54329/shadow
# Database tests (`npm run test:db`, spec 0002): a throwaway database in the same container,
# made once with `podman exec aurevia-shadow createdb -U postgres aurevia_test`. Every run drops
# and rebuilds its `public` schema, so the tests refuse any host that is not this machine.
# Vitest never reads this file; both URLs below are the defaults, so export them only to change them.
# TEST_DATABASE_URL=postgresql://postgres:shadow@127.0.0.1:54329/aurevia_test
