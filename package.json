{
  "name": "aurevia-estates",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "postinstall": "prisma generate",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "db:seed": "prisma db seed",
    "db:drift": "prisma migrate diff --from-migrations prisma/migrations --to-schema prisma/schema.prisma --exit-code",
    "test:e2e": "playwright test",
    "eval:assistant": "tsx --conditions=react-server scripts/eval-assistant.ts",
    "agent:promote": "tsx --conditions=react-server scripts/agent-promote.ts",
    "agent:demote": "tsx --conditions=react-server scripts/agent-demote.ts",
    "mfa:reset": "tsx --conditions=react-server scripts/mfa-reset.ts"
  },
  "dependencies": {
    "@ai-sdk/react": "4.0.150",
    "@hcaptcha/react-hcaptcha": "2.2.0",
    "@openrouter/ai-sdk-provider": "3.1.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@react-email/components": "1.0.12",
    "@react-email/render": "2.0.6",
    "@sentry/nextjs": "11.8.0",
    "ai": "7.0.146",
    "better-auth": "1.7.12",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "dotenv": "18.0.8",
    "leaflet": "1.9.4",
    "libphonenumber-js": "1.13.15",
    "lucide-react": "1.59.0",
    "next": "16.4.2",
    "pg": "8.23.1",
    "posthog-js": "1.438.9",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-leaflet": "5.0.0",
    "resend": "6.34.1",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/leaflet": "1.9.20",
    "@types/node": "^20",
    "@types/pg": "8.23.1",
    "@types/qrcode": "1.5.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "prisma": "7.10.1",
    "tailwindcss": "^4",
    "tsx": "4.23.15",
    "typescript": "^5"
  }
}
